# --- required -------------------------------------------------------------
# Get one at https://platform.openai.com/api-keys
# or at https://platform.deepseek.com/api_keys (see the DeepSeek profile below)
OPENAI_API_KEY=sk-your-key-here

# --- optional -------------------------------------------------------------
# Model id used when --model is not passed.
OPENAI_MODEL=gpt-4o-mini

# Any OpenAI-compatible gateway (Azure, OpenRouter, a local vLLM, ...).
# Leave empty for the official API.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- DeepSeek profile -----------------------------------------------------
# Running against DeepSeek's official API instead. Available model ids come
# from GET https://api.deepseek.com/models :
#   deepseek-flash    (DeepSeek-V4.1-Flash)
#   deepseek-v4-pro
# Keep the /v1 suffix — /chat/completions is appended to OPENAI_BASE_URL.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=deepseek-flash
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# Request timeout in seconds, and retry count.
# OPENAI_TIMEOUT=60
# OPENAI_MAX_RETRIES=2

# Force a specific shell for the bash tool.
# SUUCLAW_SHELL=/bin/bash -c

# Token budget the context monitor enforces before it flags a compression pass
# (default 400000). Lower it to watch stage 4's compression fire on a modest
# transcript instead of a genuinely huge one. Only the context-aware graph has a
# monitor — the default CLI graph runs without one, so this changes nothing there.
# SUUCLAW_CONTEXT_TOKEN_LIMIT=50000

# --- SuuClaw Feishu Bot gateway --------------------------------------------------
# SuuClaw gateway settings use the SUUCLAW_FEISHU_ prefix.
# Create an internal Feishu app, enable its Bot capability, subscribe to
# im.message.receive_v1 using long connection, then fill in these two values.
# FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Read-only seed/template and isolated per-conversation workspaces.
# SUUCLAW_FEISHU_WORKSPACE=workspace
# SUUCLAW_FEISHU_SESSION_ROOT=workspace/.suuclaw/feishu/conversations

# Safe headless default: risky shell commands are refused. Set auto only when
# the bot and its host are trusted and intentionally allowed to run them.
# SUUCLAW_FEISHU_APPROVAL_MODE=deny
# SUUCLAW_FEISHU_MAX_CONCURRENCY=4
# SUUCLAW_FEISHU_MAX_ATTEMPTS=3
# SUUCLAW_FEISHU_MAX_LOOPS=25
# SUUCLAW_FEISHU_COMMAND_TIMEOUT=120
# Initial identity lookup plus WebSocket reconnects can take longer than one
# handshake. WebSocket is direct by default; set `auto` only when it should
# honor HTTP(S)_PROXY and NO_PROXY instead.
# SUUCLAW_FEISHU_CONNECT_TIMEOUT=120
# SUUCLAW_FEISHU_WS_PROXY=direct
# SUUCLAW_FEISHU_WS_OPEN_TIMEOUT=30
# A generic acknowledgement is followed by route-aware workflow milestones.
# SUUCLAW_FEISHU_PROCESSING_TEXT=收到，正在判断任务类型…
# Keep one editable Chinese Markdown panel with workflow phase, elapsed time,
# tool activity, verification rounds, and completion state.
# SUUCLAW_FEISHU_WORKFLOW_PROGRESS=true
# SUUCLAW_FEISHU_WORKFLOW_HEARTBEAT_SECONDS=60
# Hard deadline for intent routing/chat entry. A timeout safely falls through
# to the tool workflow instead of leaving Feishu silent before traces begin.
# SUUCLAW_FEISHU_ENTRY_TIMEOUT=30
# Automatically send files successfully written by this Agent turn back to the
# same Feishu conversation. Before upload they are copied to an isolated,
# per-turn snapshot outside the Agent workdir. Hidden/sensitive, empty,
# oversized, and excess files are skipped.
# SUUCLAW_FEISHU_DELIVER_ARTIFACTS=true
# SUUCLAW_FEISHU_ARTIFACT_MAX_FILES=8
# SUUCLAW_FEISHU_ARTIFACT_MAX_MB=25

# DMs are accepted; group messages require an explicit @Bot by default.
# SUUCLAW_FEISHU_DM_POLICY=open
# SUUCLAW_FEISHU_GROUP_POLICY=open
# SUUCLAW_FEISHU_REQUIRE_MENTION=true
# SUUCLAW_FEISHU_ALLOW_FROM=ou_open_id_1,ou_open_id_2
# SUUCLAW_FEISHU_GROUP_ALLOWLIST=oc_chat_id_1,oc_chat_id_2

# Delivery reliability and response formatting.
# SUUCLAW_FEISHU_DEDUP_TTL=43200
# SUUCLAW_FEISHU_STALE_WINDOW_MS=1800000
# SUUCLAW_FEISHU_BATCH_DELAY_MS=600
# SUUCLAW_FEISHU_TEXT_CHUNK_LIMIT=3500
# SUUCLAW_FEISHU_OUTBOUND_ATTEMPTS=3
# SUUCLAW_FEISHU_REPLY_IN_THREAD=false
